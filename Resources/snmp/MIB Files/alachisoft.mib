-------------Client Counters Table----------------
clientTable OBJECT-TYPE
      SYNTAX      SEQUENCE OF ClientEntry
      MAX-ACCESS  not-accessible
      STATUS      current
      DESCRIPTION
              "A list of interface entries.  The number of entries
               is given by the value of ifNumber."
       ::= { client 1 }
clientEntry OBJECT-TYPE
     SYNTAX      ClientEntry
     MAX-ACCESS  not-accessible
     STATUS      current
     DESCRIPTION
             "An entry containing management information applicable
             to a particular interface."
     INDEX   { clientIndex }
     ::= { clientTable 1 }
	 

ClientEntry ::=
    SEQUENCE {
        clientIndex                       Integer32 ,
        client_cacheName                         DisplayString,
		client_cacheConfigId                     DisplayString,
		bindIP                            DisplayString,
		client_fetchesPerSec                     Counter64,
		client_additionPerSec                    Counter64,
		client_updatesPerSec                     Counter64,
		client_deletesPerSec                     Counter64,
		readOperationsPerSec              Counter64,
		writeOperationsPerSec             Counter64,
		client_averageMSecPerFetch               Counter64,
		client_averageMSecPerAdd                 Counter64,
		client_averageMSecPerInsert              Counter64,
		client_averageMSecPerRemove              Counter64,
		requestQueueSize                  Counter64,
		compressionsPerSec                Counter64,
		averageItemSize                   Counter64,
		averageMSecPerEvent               Counter64,
		eventsProcessedPerSec             Counter64,
		eventsTriggeredPerSec             Counter64,
		averageMSecPerCompression         Counter64,
		averageMSecPerDecompression       Counter64,
		averageMSecPerEncryption          Counter64,
		averageMSecPerDecryption          Counter64,
		averageCompressedItemSize         Counter64,
		averageMSecPerSerialization       Counter64,
		averageMSecPerDeserialization     Counter64,
		averageMSecPerAddbulk             Counter64,
		averageMSecPerFetchbulk           Counter64,
		averageMSecPerInsertbulk          Counter64,
		averageMSecPerRemovebulk          Counter64,
		numberOfLastSyncPollUpdates       Counter64,
		numberOfLastSyncPollRemoves       Counter64,
		averageMSecPerPublishedMessages   Counter64,
		client_messagesPublishedPerSec           Counter64,
		client_messagesDeliveredPerSec           Counter64
	}

clientIndex OBJECT-TYPE
    SYNTAX      Integer32 
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
            "A unique value, greater than zero, for each cache."
    ::= { clientEntry 1 }
client_cacheName  OBJECT-TYPE
SYNTAX DisplayString
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Name of the cache to which client is connected."
::= {clientEntry 2}

client_cacheConfigId  OBJECT-TYPE
SYNTAX DisplayString
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Config-ID of the cache to which client is connected."
::= {clientEntry 3}

bindIP  OBJECT-TYPE
SYNTAX DisplayString
ACCESS read-only
STATUS mandatory
DESCRIPTION
	""
::= {clientEntry 4}

client_fetchesPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Get operations per second."
::= {clientEntry 5}

client_additionPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Add operations per second."
::= {clientEntry 6}

client_updatesPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Insert operations per second."
::= {clientEntry 7}

client_deletesPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Remove operations per second."
::= {clientEntry 8}

readOperationsPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Read operations per second."
::= {clientEntry 9}

writeOperationsPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Write operations per second."
::= {clientEntry 10}

client_averageMSecPerFetch  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete one fetch operation."
::= {clientEntry 11}

client_averageMSecPerAdd  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete one add operation."
::= {clientEntry 12}

client_averageMSecPerInsert  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds, taken to complete one insert operation."
::= {clientEntry 13}

client_averageMSecPerRemove  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete one remove operation."
::= {clientEntry 14}

requestQueueSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Total number of requests from all clients on a single machine waiting for response from cache server."
::= {clientEntry 15}

compressionsPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Rate of compression/decompression i.e. how many items are compressed/decompression during one second interval."
::= {clientEntry 16}

averageItemSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average size of the item added to/fetched from the cache by the client. Average size is calculated before compression/after decompression is applied."
::= {clientEntry 17}

averageMSecPerEvent  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken in single event processing on the client."
::= {clientEntry 18}

eventsProcessedPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of events processed per sec on client."
::= {clientEntry 19}

eventsTriggeredPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of events triggered and received by client per second."
::= {clientEntry 20}

averageMSecPerCompression  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to compress one object."
::= {clientEntry 21}

averageMSecPerDecompression  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to decompress one object."
::= {clientEntry 22}

averageMSecPerEncryption  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to encrypt one object."
::= {clientEntry 23}

averageMSecPerDecryption  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to decrypt one object."
::= {clientEntry 24}

averageCompressedItemSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average size in bytes, item size after compression on add or item size before decompression on fetch."
::= {clientEntry 25}

averageMSecPerSerialization  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to serialize one object."
::= {clientEntry 26}

averageMSecPerDeserialization  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to deserialize one object."
::= {clientEntry 27}

averageMSecPerAddbulk  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete bulk add operation."
::= {clientEntry 28}

averageMSecPerFetchbulk  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete bulk get operation."
::= {clientEntry 29}

averageMSecPerInsertbulk  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete bulk insert operation."
::= {clientEntry 30}

averageMSecPerRemovebulk  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete bulk remove operation."
::= {clientEntry 31}

numberOfLastSyncPollUpdates  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Updates resulted in last Sync Poll."
::= {clientEntry 32}

numberOfLastSyncPollRemoves  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Removes resulted in last Sync Poll."
::= {clientEntry 33}

averageMSecPerPublishedMessages  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds, taken to complete publish messages operation."
::= {clientEntry 34}

client_messagesPublishedPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of messages published per second."
::= {clientEntry 35}

client_messagesDeliveredPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of messages delivered to subsribers per second."
::= {clientEntry 36}


