slidingIndexqueuesize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items in the Sliding-Index queue."
::= {cacheEntry 95}

socketRecvSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"How much data was received in the last message."
::= {cacheEntry 96}

socketRecvtime  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Time in milli seconds it took to receive the last message."
::= {cacheEntry 97}

socketSendSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"How much data was sent in the last message."
::= {cacheEntry 98}

socketSendTime  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Time in milli seconds it took for the last message to be sent over the socket."
::= {cacheEntry 99}

stateTransferPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items this node is either reading from other nodes or sending to other nodes during a state transfer mode."
::= {cacheEntry 100}

tcpDownEnterPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items in BCast queue waiting to be processed on sequence."
::= {cacheEntry 101}

tcpDownQueueCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items in TCP down-queue."
::= {cacheEntry 102}

tcpUpQueueCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items in TCP up-queue."
::= {cacheEntry 103}

topicsCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Topics in the cache."
::= {cacheEntry 104}

writeBehindBatchCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of operations selected in current batch interval for execution. For write-behind, if batching is enabled, number of operations dequeued in current batch interval for execution is displayed by this counter."
::= {cacheEntry 105}

writeBehindEvictionsPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of items evicted per second from write-behind queue. Only failed operation are evicted which are enqueued for operation retry."
::= {cacheEntry 106}

writeBehindFailureRetrycount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of operations failed enqueued for retry. Data source write operation returning FailureRetry as status are also enqueued for retry."
::= {cacheEntry 107}

writeBehindQueueCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of operations in Write-behind queue."
::= {cacheEntry 108}

writeBehindPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Write-behind operations per second."
