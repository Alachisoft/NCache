writeThruPerSec  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Number of Write-thru operations per second."
::= {cacheEntry 110}

totalCacheSize  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Total size of the cache."
::= {cacheEntry 111}

configuredServersCount  OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Total number of configured servers against the cache."
::= {cacheEntry 112}

averageMSecPerAdd OBJECT-TYPE
SYNTAX Counter64
ACCESS read-only
STATUS mandatory
DESCRIPTION
	"Average time in microseconds (us), taken to complete one add operation."
::= {cacheEntry 113}

